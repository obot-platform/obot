stateDiagram-v2
  state "Legend" as legend {
    lg0: Cold snapshot
    lg1: Snapshot load
    lg2: Snapshot rejected
    lg3: Protected execution
    lg4: Fence bypassed
    lg5: Breaks ExecutionEnteredAtMostOnce or NoRetryAfterUncertainOutcome or UpstreamRequiresOneSnapshotAndOneFence
    lg6: Path to the ExecutionEnteredAtMostOnce or NoRetryAfterUncertainOutcome or UpstreamRequiresOneSnapshotAndOneFence bug
