{
  "name": "my-website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "verify": "npm run typecheck && npm run build",
    "test:docs": "playwright test navigation.spec.ts",
    "preview:pages": "WRANGLER_SEND_METRICS=false wrangler pages dev build --ip 0.0.0.0 --port 3000 --compatibility-date=2026-09-25",
    "test:obot": "playwright test --config playwright.obot.config.ts"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mdx-js/react": "^3.1.0",
    "clsx": "^2.1.0",
    "mermaid": "11.16.1",
    "prism-react-renderer": "^2.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@playwright/test": "^1.63.0",
    "typescript": "~6.0.2",
    "wrangler": "^4.147.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "qs": "6.16.0",
    "serialize-javascript": "7.0.5",
    "uuid": "11.1.1",
    "gray-matter": {
      "js-yaml": "3.15.0"
    },
    "tinypool": "2.1.2",
    "sharp": "0.35.5",
    "postcss-selector-parser": "7.1.6",
    "katex": "0.18.2"
  }
}
