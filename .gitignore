# Ignore binary files
bin/

# Random TLS files
apiserver.local.config/
# Ignore the kubeconfig file
kubeconfig

# Ignore envrc
.envrc

# Ignore any compiled Go binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Ignore Go build artifacts
*.log
*.test
*.out

# Ignore packed helm chart
.packaged/

# Ignore GoReleaser output
/dist/

# Ignore dependency directories
vendor/
node_modules/

# Ignore temporary files
*.tmp
*.swp
*.swo
*.bak
*.old

# Ignore IDE specific files
.vscode/
.idea/
*.iml

# Ignore OS specific files
.DS_Store
Thumbs.db

# Ignore local DB files
obot*.db*

# Ignore http dir for http client files
http/

# Ignore the catalog.json file downloaded from the MCP registry
catalog.json

# Ignore Kiro files
.kiro/

# Ignore zed files
.zed/
__debug_*

**/.claude/settings.local.json
thoughts/
thoughts

.opencode/

# Riptide artifacts (cloud-synced)
.humanlayer/tasks/

# Ignore Python bytecode
__pycache__/
*.py[cod]

.pnpm-store/

# Model data downloaded at build time (see pkg/modeldata/data/README.md)
/pkg/modeldata/data/*.json.gz
/pkg/modeldata/data/generated
