{
	"name": "user",
	"version": "0.0.1",
	"private": true,
	"packageManager": "pnpm@12.9.1",
	"engines": {
		"node": "^24.0.0 || >=26.0.0",
		"pnpm": ">=12.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run --browser.headless",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale",
		"check": "pnpm run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "pnpm run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"ci": "npm run format && npm run lint && npm run check"
	},
	"devDependencies": {
		"@babel/runtime": "^7.29.2",
		"@codemirror/autocomplete": "^6.20.1",
		"@codemirror/commands": "^6.10.3",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-yaml": "^6.1.3",
		"@codemirror/language": "^6.12.3",
		"@codemirror/lint": "^6.9.5",
		"@codemirror/search": "^6.6.0",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.41.0",
		"@eslint/js": "^10.0.1",
		"@faker-js/faker": "^10.5.0",
		"@floating-ui/dom": "^1.7.6",
		"@inlang/paraglide-js": "2.25.4",
		"@inlang/plugin-message-format": "4.4.4",
		"@lucide/svelte": "^1.21.0",
		"@milkdown/crepe": "^7.22.2",
		"@milkdown/kit": "^7.22.2",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/d3": "^7.4.3",
		"@types/d3-time-format": "^4.0.3",
		"@types/eslint": "^9.6.1",
		"@types/node": "^24.13.3",
		"@uiw/codemirror-theme-github": "^4.25.9",
		"@vitest/browser-playwright": "^5.0.1",
		"dompurify": "3.4.16",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^15.15.0",
		"micromark": "^4.0.2",
		"micromark-extension-gfm": "^3.0.0",
		"msw": "^2.15.0",
		"playwright": "^1.62.1",
		"postcss": "^8.5.25",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.7.0",
		"tailwind-scrollbar": "^4.0.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.61.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.1",
		"vitest-browser-svelte": "^3.1.0"
	},
	"type": "module",
	"dependencies": {
		"@codemirror/lang-markdown": "^6.5.0",
		"@modelcontextprotocol/sdk": "^1.31.0",
		"@oddbird/popover-polyfill": "^0.6.1",
		"@xterm/addon-fit": "^0.10.0",
		"@xterm/xterm": "^5.5.0",
		"d3": "^7.9.0",
		"d3-time-format": "^4.1.0",
		"daisyui": "^5.7.18",
		"date-fns": "^4.1.0",
		"devicon": "^2.17.0",
		"driver.js": "^1.4.0",
		"es-toolkit": "^1.45.1"
	},
	"msw": {
		"workerDirectory": [
			"static"
		]
	}
}
